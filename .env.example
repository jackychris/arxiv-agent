DEEPSEEK_API_KEY=your_key_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here  # optional, read-only GitHub MCP access
TAVILY_API_KEY=your_tavily_api_key_here
PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here  # optional

# Optional runtime timeout overrides, in seconds.
SERVER_START_TIMEOUT=60
SSE_HEARTBEAT_INTERVAL=20
A2A_CLIENT_TIMEOUT=300
MCP_TOOL_TIMEOUT=90
MCP_TOOL_RETRY_ATTEMPTS=3
MCP_TOOL_RETRY_BACKOFF_SECONDS=2
MCP_ARXIV_MIN_INTERVAL_SECONDS=5
WEB_FETCH_TIMEOUT=30
ARXIV_FETCH_TIMEOUT=30
ARXIV_429_RETRY_DELAYS=30,60,120
GITHUB_HTTP_TIMEOUT=15

# Set to false to disable cross-task context sharing between parallel subagents.
ENABLE_RUN_CONTEXT=true
RUN_CONTEXT_ENTRY_MAX_CHARS=500

# Structured run traces are written as JSONL files under TRACE_DIR.
ENABLE_TRACE=true
TRACE_DIR=runs

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
